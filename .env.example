# GitLab Terraform Importer Configuration
# Copy this file to .env and fill in your values

# GitLab Instance Configuration
# URL of your GitLab instance (default: https://gitlab.com)
GITLAB_URL=https://gitlab.com

# GitLab Personal Access Token (required)
# Create a token with 'api' scope at:
# https://gitlab.com/-/user_settings/personal_access_tokens
GITLAB_TOKEN=your-gitlab-token-here

# Root Group Configuration
# Specify either group ID or group path (at least one required)

# Group ID (numeric)
# GITLAB_ROOT_GROUP_ID=12345

# Group path (e.g., "my-organization" or "my-org/sub-group")
GITLAB_ROOT_GROUP_PATH=my-organization

# Output Configuration
# Directory where Terraform files will be generated
GITLAB_OUTPUT_DIR=./terraform

# API Configuration
# Request timeout in seconds (default: 60)
GITLAB_TIMEOUT=60

# Verify SSL certificates (default: true)
GITLAB_VERIFY_SSL=true

# Import Options
# Include archived projects in the import (default: false)
GITLAB_INCLUDE_ARCHIVED=false

# Maximum group depth to import (empty for unlimited)
# GITLAB_MAX_DEPTH=5

# Terraform/OpenTofu Configuration
# Binary to use for import commands (terraform or tofu)
# Default: terraform
GITLAB_TERRAFORM_BINARY=terraform

# Output format for Terraform files (hcl or json)
# - hcl: Standard HCL format (.tf files)
# - json: JSON format (.tf.json files)
# Default: hcl
GITLAB_OUTPUT_FORMAT=hcl
